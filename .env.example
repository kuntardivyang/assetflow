# Postgres connection — each teammate sets their own local DB.
# TCP form (needs a password):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/assetflow?schema=public"
# If your local Postgres uses peer auth over a unix socket instead, use:
# DATABASE_URL="postgresql://USER@localhost/assetflow?host=/var/run/postgresql&schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
AUTH_TRUST_HOST=true
